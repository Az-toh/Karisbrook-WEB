@model KarisBrook.Models.Product

@{
    ViewData["Title"] = "Редактировать товар";
}

<div class="container mt-4">
    <h2>Редактировать товар</h2>
    <p><strong>Артикул:</strong> @ViewBag.Article</p>

    <form asp-action="Edit" method="post">
        <input type="hidden" name="id" value="@Model.Id" />

        <div class="form-group">
            <label>Название</label>
            <input name="name" value="@Model.Name" class="form-control" required />
        </div>
        <div class="form-group">
            <label>Описание</label>
            <textarea name="description" class="form-control">@Model.Description</textarea>
        </div>
        <div class="form-group">
            <label>Категория</label>
            <select name="categoryId" class="form-control" asp-items="ViewBag.Categories"></select>
        </div>
        <div class="form-group">
            <label>Бренд</label>
            <select name="brandId" class="form-control" asp-items="ViewBag.Brands"></select>
        </div>
        <div class="form-group">
            <label>Цена закупки</label>
            <input name="purchasePrice" value="@ViewBag.PurchasePrice" type="number" step="0.01" class="form-control" required />
        </div>
        <div class="form-group">
            <label>Ссылка на фото</label>
            <input name="sourceImageUrl" value="@ViewBag.SourceImageUrl" class="form-control" placeholder="https://example.com/photo.jpg" />
        </div>
        <button type="submit" class="btn btn-primary">Сохранить изменения</button>
        <a asp-action="Index" class="btn btn-secondary">Отмена</a>
    </form>
</div>