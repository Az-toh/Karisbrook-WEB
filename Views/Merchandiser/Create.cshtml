@{
    ViewData["Title"] = "Добавить товар";
}

<div class="container mt-4">
    <h2>Добавить товар</h2>

    <form asp-action="Create" method="post">
        <div class="form-group">
            <label>Название</label>
            <input name="name" class="form-control" required />
        </div>
        <div class="form-group">
            <label>Описание</label>
            <textarea name="description" class="form-control"></textarea>
        </div>
        <div class="form-group">
            <label>Категория</label>
            <select name="categoryId" class="form-control" asp-items="ViewBag.Categories"></select>
        </div>
        <div class="form-group">
            <label>Бренд</label>
            <select name="brandId" class="form-control" asp-items="ViewBag.Brands"></select>
        </div>
        <div class="form-group">
            <label>Цена закупки</label>
            <input name="purchasePrice" type="number" step="0.01" class="form-control" required />
        </div>
        <div class="form-group">
            <label>Ссылка на фото</label>
            <input name="sourceImageUrl" class="form-control" placeholder="https://example.com/photo.jpg" />
            <small class="form-text text-muted">Оставьте пустым, чтобы использовать заглушку.</small>
        </div>
        <button type="submit" class="btn btn-success">Сохранить</button>
        <a asp-action="Index" class="btn btn-secondary">Отмена</a>
    </form>
</div>