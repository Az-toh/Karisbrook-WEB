@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "Управление товарами";
    Layout = "_Layout";
    
}

<div class="container mt-4">
    <h2>Управление товарами</h2>
    <p>
        <a asp-action="Create" class="btn btn-primary">Добавить товар</a>
    </p>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">Товаров пока нет. Добавьте первый товар.</div>
    }
    else
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Название</th>
                    <th>Артикул</th>
                    <th>Цена</th>
                    <th>Категория</th>
                    <th>Бренд</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Product.Id</td>
                        <td>@item.Product.Name</td>
                        <td>@item.Meta?.Article</td>
                        <td>@item.Product.Price ₽</td>
                        <td>@item.Product.Category?.Name</td>
                        <td>@item.Product.Brand?.Name</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Product.Id" class="btn btn-sm btn-warning">Изменить</a>
                            <form asp-action="Delete" asp-route-id="@item.Product.Id" method="post" style="display:inline;">
                                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Удалить товар?')">Удалить</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>